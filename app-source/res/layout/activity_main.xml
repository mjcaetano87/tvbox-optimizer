<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <!-- Top Navigation Header with DPAD focusable buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="root@tvbox-optimizer:~# ./iptv-tuning"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#39FF14"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnOptimize"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="[ 🚀 OTIMIZAR ]"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_optimize_selector"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btnReboot"
            android:nextFocusDown="@+id/scrollLogs"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginRight="10dp" />

        <Button
            android:id="@+id/btnReboot"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="[ 🔄 REINICIAR ]"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_reboot_selector"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/btnOptimize"
            android:nextFocusDown="@+id/scrollLogs"
            android:paddingLeft="20dp"
            android:paddingRight="20dp" />
    </LinearLayout>

    <!-- Terminal Screen Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0A"
        android:orientation="vertical"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciando console do sistema...\n"
                android:textColor="#39FF14"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Footer: GitHub Project Link & Signature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvGithub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★ GitHub: https://github.com/mjcaetano87/tvbox-optimizer"
            android:textSize="12sp"
            android:textColor="#00E5FF"
            android:fontFamily="monospace"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/tvSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="by: jesséx10"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
