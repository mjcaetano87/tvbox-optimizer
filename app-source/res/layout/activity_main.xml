<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TVBOX OPTIMIZER FOR IPTV"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DNS 1.1.1.1/8.8.8.8 | NTP Brasil | Animações 0x | Bloqueio de Dropper Chinês"
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnOptimize"
        android:layout_width="320dp"
        android:layout_height="60dp"
        android:text="🚀 OTIMIZAR AGORA (1-CLIQUE)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#2979FF"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnReboot"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:text="🔄 REINICIAR TV BOX"
        android:textSize="14sp"
        android:background="#424242"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#1E1E1E"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aguardando comando...\nPressione 'OTIMIZAR AGORA'."
            android:textColor="#ECEFF1"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
